{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests / sec",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(stroynadzor_http_requests_total[5m]))", "legendFormat": "requests"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "API latency p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(stroynadzor_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Analysis jobs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(stroynadzor_analysis_jobs_total[5m]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Suspicion hypotheses",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (discovery_method) (rate(stroynadzor_suspicion_hypotheses_total[5m]))", "legendFormat": "{{discovery_method}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    }
  ],
  "schemaVersion": 39,
  "tags": ["stroynadzor", "ai"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Стройнадзор ИИ — обзор",
  "version": 1
}
