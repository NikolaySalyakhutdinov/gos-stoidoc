NODE_ENV=development
POSTGRES_DB=stroynadzor
POSTGRES_USER=stroynadzor
POSTGRES_PASSWORD=change-this-postgres-password
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGIN=http://localhost:8080
PYTHON_AI_URL=http://python-ai:8000/process
PYTHON_AI_TIMEOUT_MS=900000
AI_OCR_DPI=250
# Required only when PYTHON_AI_URL points to a publicly reachable deployment
# (e.g. Cloud Run) instead of the private docker-compose network. Must match
# AI_INTERNAL_TOKEN on the python-ai service.
AI_INTERNAL_TOKEN=
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_ANALYSIS_QUEUE=stroynadzor.analysis
# Set to http://logstash:8080 when the monitoring profile is enabled.
LOGSTASH_URL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-long-random-grafana-password
