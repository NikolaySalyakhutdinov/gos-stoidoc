{
  "openapi": "3.0.3",
  "info": {
    "title": "Stroynadzor AI API",
    "version": "1.0.0",
    "description": "REST API для проверки строительной документации. JSON является основным форматом бизнес-операций; загрузка файлов, SSE-прогресс, бинарный просмотр документов и Prometheus metrics описаны отдельными content types."
  },
  "servers": [{ "url": "https://{host}", "variables": { "host": { "default": "localhost" } } }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/health": {
      "get": {
        "security": [],
        "responses": {
          "200": { "description": "Состояние API", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } } },
        "responses": { "201": { "description": "Пользователь зарегистрирован", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Авторизация выполнена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } } },
        "responses": { "200": { "description": "Токены обновлены", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "responses": { "200": { "description": "Профиль", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "patch": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfilePatchRequest" } } } },
        "responses": { "200": { "description": "Профиль обновлён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/auth/me/notifications": {
      "patch": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationsPatchRequest" } } } },
        "responses": { "200": { "description": "Настройки уведомлений обновлены", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" } } } },
        "responses": { "200": { "description": "Пароль изменён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "security": [],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" } } } },
        "responses": { "200": { "description": "Запрос принят", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects": {
      "get": {
        "responses": { "200": { "description": "Список объектов", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObjectsResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateObjectRequest" } } } },
        "responses": { "201": { "description": "Объект создан", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObjectResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "responses": { "200": { "description": "Объект", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObjectResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteObjectRequest" } } } },
        "responses": { "200": { "description": "Объект удалён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/events": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "responses": { "200": { "description": "SSE-прогресс обработки", "content": { "text/event-stream": { "schema": { "type": "string" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/status": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "patch": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProcessStatusRequest" } } } },
        "responses": { "200": { "description": "Статус процесса обновлён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObjectResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/completeness": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "responses": { "200": { "description": "Полнота документов", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompletenessResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/findings": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "responses": { "200": { "description": "Результаты сравнения", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FindingsResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/suspicions": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "responses": { "200": { "description": "Гипотезы вне Матрицы", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuspicionsResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/files/{fileId}/content": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/FileId" }],
      "get": {
        "responses": {
          "200": { "description": "Исходный документ", "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } }, "application/xml": { "schema": { "type": "string", "format": "binary" } }, "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }, "application/vnd.openxmlformats-officedocument.wordprocessingml.document": { "schema": { "type": "string", "format": "binary" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/objects/{id}/findings/{findingId}/decide": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/FindingId" }],
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DecisionRequest" } } } },
        "responses": { "200": { "description": "Решение сохранено", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FindingResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/findings/{findingId}/undo": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/FindingId" }],
      "post": {
        "responses": { "200": { "description": "Решение отменено", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FindingResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/uploads": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "responses": { "200": { "description": "Загруженные документы", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadsResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/uploads/{stage}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/Stage" }],
      "post": {
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["files"], "properties": { "files": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "format": "binary" } } }, "additionalProperties": false } } } },
        "responses": { "201": { "description": "Документы загружены", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/objects/{id}/uploads/{stage}/{fileId}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/Stage" }, { "$ref": "#/components/parameters/FileId" }],
      "delete": {
        "responses": { "200": { "description": "Документ удалён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/matrix": {
      "get": {
        "responses": { "200": { "description": "Параметры Матрицы", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatrixResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatrixParameterRequest" } } } },
        "responses": { "201": { "description": "Параметр добавлен", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ParameterResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/matrix/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/MatrixId" }],
      "delete": {
        "responses": { "200": { "description": "Параметр удалён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/audit": {
      "get": {
        "responses": { "200": { "description": "Журнал аудита", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditResponse" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "ObjectId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "FileId": { "name": "fileId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "FindingId": { "name": "findingId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "MatrixId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "Stage": { "name": "stage", "in": "path", "required": true, "schema": { "type": "string", "enum": ["PD", "RD", "ID"] } }
    },
    "responses": { "Error": { "description": "Ошибка API или OpenAPI-валидации", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } },
    "schemas": {
      "ErrorResponse": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" }, "code": { "type": "string", "nullable": true }, "message": { "type": "string", "nullable": true }, "errors": { "type": "array", "items": { "type": "object", "additionalProperties": true } } }, "additionalProperties": true },
      "OkResponse": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" }, "id": { "type": "string", "nullable": true } }, "additionalProperties": true },
      "HealthResponse": { "type": "object", "required": ["ok", "service", "database"], "properties": { "ok": { "type": "boolean" }, "service": { "type": "string" }, "database": { "type": "string" } }, "additionalProperties": false },
      "User": { "type": "object", "required": ["id", "name", "email", "role", "org", "phone", "createdAt", "notifPrefs"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "role": { "type": "string", "enum": ["INSPECTOR", "ADMIN", "ML_ENGINEER"] }, "org": { "type": "string" }, "phone": { "type": "string", "nullable": true }, "createdAt": { "type": "string", "format": "date-time", "nullable": true }, "notifPrefs": { "type": "object", "required": ["emailDigest", "criticalAlerts", "weeklyReport"], "properties": { "emailDigest": { "type": "boolean" }, "criticalAlerts": { "type": "boolean" }, "weeklyReport": { "type": "boolean" } }, "additionalProperties": false } }, "additionalProperties": false },
      "AuthResponse": { "type": "object", "required": ["token", "refreshToken", "user"], "properties": { "token": { "type": "string" }, "refreshToken": { "type": "string" }, "user": { "$ref": "#/components/schemas/User" } }, "additionalProperties": false },
      "UserResponse": { "type": "object", "required": ["user"], "properties": { "user": { "$ref": "#/components/schemas/User" } }, "additionalProperties": false },
      "RegisterRequest": { "type": "object", "required": ["name", "email", "password"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 6, "maxLength": 200 }, "role": { "type": "string", "enum": ["INSPECTOR", "ADMIN", "ML_ENGINEER"] }, "org": { "type": "string", "maxLength": 300 } }, "additionalProperties": false },
      "LoginRequest": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 1, "maxLength": 200 } }, "additionalProperties": false },
      "RefreshRequest": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      "ProfilePatchRequest": { "type": "object", "minProperties": 1, "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "email": { "type": "string", "format": "email" }, "phone": { "type": "string", "maxLength": 50 } }, "additionalProperties": false },
      "NotificationsPatchRequest": { "type": "object", "minProperties": 1, "properties": { "emailDigest": { "type": "boolean" }, "criticalAlerts": { "type": "boolean" }, "weeklyReport": { "type": "boolean" } }, "additionalProperties": false },
      "ChangePasswordRequest": { "type": "object", "required": ["current", "next"], "properties": { "current": { "type": "string", "minLength": 1 }, "next": { "type": "string", "minLength": 6, "maxLength": 200 } }, "additionalProperties": false },
      "ForgotPasswordRequest": { "type": "object", "properties": { "email": { "type": "string", "format": "email" } }, "additionalProperties": false },
      "CreateObjectRequest": { "type": "object", "required": ["name", "address", "object_code", "customer", "contractor", "permit_number"], "properties": { "name": { "type": "string", "minLength": 1 }, "address": { "type": "string", "minLength": 1 }, "object_code": { "type": "string", "minLength": 1 }, "customer": { "type": "string", "minLength": 1 }, "contractor": { "type": "string", "minLength": 1 }, "permit_number": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      "DeleteObjectRequest": { "type": "object", "required": ["reasonCode"], "properties": { "reasonCode": { "type": "string", "enum": ["DUPLICATE_OBJECT", "TEST_OBJECT", "WRONG_DATA", "PROJECT_CANCELLED", "OTHER"] }, "comment": { "type": "string", "maxLength": 2000 } }, "additionalProperties": false },
      "ProcessStatusRequest": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["PENDING", "PARSING", "READY", "VERIFYING", "COMPLETED", "FINALIZED", "FAILED"] } }, "additionalProperties": false },
      "DecisionRequest": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["CONFIRMED_VIOLATION", "NEGATIVE_VERIFIED", "CLARIFICATION_REQUIRED", "CANDIDATE", "NOT_APPLICABLE", "NOT_COMPARABLE"] }, "reason_code": { "type": "string", "enum": ["WRONG_REVISION", "APPROVED_CHANGE", "OCR_ERROR", "LINK_ERROR", "NOT_APPLICABLE_PARAM", "OTHER"] }, "comment": { "type": "string", "maxLength": 5000 } }, "additionalProperties": false },
      "MatrixParameterRequest": { "type": "object", "required": ["code", "section", "parameter", "trigger"], "properties": { "code": { "type": "string", "minLength": 1 }, "section": { "type": "string", "minLength": 1 }, "parameter": { "type": "string", "minLength": 1 }, "unit": { "type": "string", "nullable": true }, "source_pd": { "type": "string", "nullable": true }, "source_rd": { "type": "string", "nullable": true }, "source_id": { "type": "string", "nullable": true }, "trigger": { "type": "string", "minLength": 1 }, "priority": { "type": "string" } }, "additionalProperties": false },
      "JsonObject": { "type": "object", "additionalProperties": true },
      "ObjectResponse": { "type": "object", "required": ["object"], "properties": { "object": { "$ref": "#/components/schemas/JsonObject" } }, "additionalProperties": true },
      "ObjectsResponse": { "type": "object", "required": ["objects"], "properties": { "objects": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } } }, "additionalProperties": true },
      "CompletenessResponse": { "type": "object", "required": ["completeness"], "properties": { "completeness": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } } }, "additionalProperties": true },
      "FindingsResponse": { "type": "object", "required": ["findings"], "properties": { "findings": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } } }, "additionalProperties": true },
      "FindingResponse": { "type": "object", "required": ["finding"], "properties": { "finding": { "$ref": "#/components/schemas/JsonObject" } }, "additionalProperties": true },
      "SuspicionsResponse": { "type": "object", "required": ["suspicions"], "properties": { "suspicions": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } } }, "additionalProperties": true },
      "UploadsResponse": { "type": "object", "required": ["uploads"], "properties": { "uploads": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } } } }, "additionalProperties": true },
      "UploadResponse": { "type": "object", "required": ["uploaded", "process_id"], "properties": { "uploaded": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } }, "process_id": { "type": "string" } }, "additionalProperties": true },
      "MatrixResponse": { "type": "object", "required": ["matrix"], "properties": { "matrix": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } } }, "additionalProperties": true },
      "ParameterResponse": { "type": "object", "required": ["parameter"], "properties": { "parameter": { "$ref": "#/components/schemas/JsonObject" } }, "additionalProperties": true },
      "AuditResponse": { "type": "object", "required": ["events"], "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } } }, "additionalProperties": true },
      "DeleteResponse": { "type": "object", "required": ["ok", "id"], "properties": { "ok": { "type": "boolean" }, "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } }, "additionalProperties": true }
    }
  }
}
